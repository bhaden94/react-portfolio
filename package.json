{
  "name": "portfolio",
  "homepage": "https://www.bradyhaden.com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@sanity/vision": "^3.57.4",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.1.1",
    "prettier": "3.3.3",
    "react-is": "^18.3.1",
    "sanity": "^3.57.4",
    "styled-components": "^6.5.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.7"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "content": "node scripts/fetch-content.mjs",
    "prebuild": "node scripts/fetch-content.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "seed": "node scripts/generate-seed.mjs",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
